{
  "name": "@flutchai/flutch-cli",
  "version": "0.0.1",
  "description": "CLI tool for managing Flutch graph versions and deployments",
  "main": "dist/index.js",
  "bin": {
    "flutch": "dist/index.js"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "npx tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "npx tsc --noEmit"
  },
  "keywords": [
    "cli",
    "graph",
    "versioning",
    "amelie",
    "ai"
  ],
  "author": "Flutch Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.0.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "cosmiconfig": "^8.0.0",
    "inquirer": "^8.2.5",
    "joi": "^17.9.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3",
    "@types/node": "^24.9.2",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.6.0+sha224.acd0786f07ffc6c933940eb65fc1d627131ddf5455bddcc295dc90fd"
}
